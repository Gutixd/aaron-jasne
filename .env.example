# ── Supabase ────────────────────────────────────────────────────────
# Project Settings › API. La anon key es pública por diseño: viaja en el
# bundle y lo que protege los datos son las políticas RLS de schema.sql.
# NUNCA pongas aquí la service_role key — esta app corre entera en el
# navegador y quedaría expuesta a cualquiera.
#
# Sin estas dos el sitio corre en modo demostración: se ve completo y los
# formularios validan, pero nada se guarda.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google Analytics 4 (opcional) ───────────────────────────────────
# Sin ID no se carga ningún script de rastreo ni se hace ninguna petición.
VITE_GA_ID=
